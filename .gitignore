# ==========================================================
# .gitignore - O que o Git deve ignorar neste projeto
# Pra que serve?
# - Manter dependências, builds e segredos fora do repositório
# - Garantir que nenhum .env com senha real vá pro GitHub
# ==========================================================

# --- Dependências ---
node_modules/
.pnp/
.pnp.js
jspm_packages/

# --- Builds e saídas de compilação ---
dist/
build/
out/
*.tsbuildinfo

# --- Segredos: nunca versionar .env de verdade ---
.env
.env.*
!.env.example
!.env-example

# --- Logs ---
*.log
# Só a pasta logs/ da raiz: "logs/" sozinho pegava também frontend/src/pages/logs
/logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
venv/
.venv/
env/
ENV/
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# --- C++ ---
*.o
*.obj
*.a
*.lib
*.so
*.dylib
*.dll
*.exe
CMakeFiles/
CMakeCache.txt
cmake_install.cmake
Makefile
compile_commands.json

# --- Prisma (banco local de testes) ---
*.db
*.db-journal
*.sqlite
*.sqlite3

# --- Editores e SO ---
.vscode/*
!.vscode/extensions.json
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
desktop.ini

# --- Ferramentas locais ---
.cache/
.temp/
.tmp/
coverage/
graphify-out/
tcc/
