# ==========================================================
# .env.example - Modelo das variáveis do sistema Python
# # Pra que serve?
# - Configurar o acesso ao banco e ao sensor biométrico R307
# - Servir de base pro seu .env local (que NUNCA vai pro Git)
# Versão: 1.1.0
# Data: 2026-09-09
#
# Como usar:
#   cp .env.example .env
# ==========================================================

# --- Banco de dados ---
# Use exatamente a mesma URL configurada em backend/.env
DATABASE_URL=postgresql://usuario:senha@localhost:5432/biometric_access?schema=public

# --- Sensor biométrico R307 ---
SENSOR_DEVICE=R307
# No Linux costuma ser /dev/ttyUSB0; no Windows, algo como COM3
SENSOR_PORT=/dev/ttyUSB0
SENSOR_BAUDRATE=57600

# --- Logs ---
# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
LOG_FILE=biometric_query.log

# --- Unidade escolar onde o sensor está instalado ---
DEFAULT_UNIT_CODE=ETE001
