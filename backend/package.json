{
  "name": "biometric-access-control-api",
  "version": "1.0.0",
  "main": "dist/server.js",
  "scripts": {
    "dev": "npm run db:setup && ts-node-dev --respawn --transpile-only src/server.ts",
    "dev:only": "prisma generate && ts-node-dev --respawn --transpile-only src/server.ts",
    "db:setup": "prisma generate && ts-node --transpile-only scripts/setup-db.ts",
    "build": "prisma generate && tsc",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "smoke": "ts-node --transpile-only scripts/smoke.ts",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "db:seed": "prisma db seed"
  },
  "keywords": [
    "fastify",
    "prisma",
    "postgresql",
    "zod",
    "biometrics",
    "typescript"
  ],
  "author": "Arthur Roberto Weege Pontes",
  "license": "MIT",
  "description": "API de controle de acesso biometrico para Etecs e Fatecs (Fastify + Prisma + Zod)",
  "dependencies": {
    "@fastify/cors": "^11.1.0",
    "@fastify/swagger": "^9.5.2",
    "@fastify/swagger-ui": "^5.2.3",
    "@prisma/client": "^6.17.1",
    "bcrypt": "^6.0.0",
    "dotenv": "^17.2.3",
    "fastify": "^5.6.1",
    "fastify-type-provider-zod": "^6.0.0",
    "jsonwebtoken": "^9.0.2",
    "nodemailer": "^7.0.9",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^24.8.0",
    "@types/nodemailer": "^7.0.2",
    "nodemon": "^3.1.10",
    "prisma": "^6.17.1",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.9.3"
  },
  "prisma": {
    "seed": "ts-node --transpile-only prisma/seed.ts"
  }
}
