# ==========================================================
# .env.example - Modelo das variáveis de ambiente do backend
# # Pra que serve?
# - Mostrar quais variáveis a API precisa pra funcionar
# - Servir de base pro seu .env local (que NUNCA vai pro Git)
# Feito por: Arthur Roberto Weege Pontes
# Versão: 2.0.0
# Data: 2026-09-09
# Alterações:
# - v1.0.0 (2025-03-15): Configurações iniciais
# - v1.1.0 (2025-04-01): Adicionadas políticas de segurança
# - v1.2.0 (2025-04-10): Suporte a múltiplos ambientes
# - v1.3.0 (2025-04-20): Configuração de timeout para o banco
# - v2.0.0 (2026-09-09): Arquivo sanitizado e documentado variável por variável
#
# Como usar:
#   cp .env.example .env
# Depois preenche cada campo abaixo com os seus valores de verdade.
# ==========================================================

# --- Ambiente ---
# development | staging | production
# Em production o servidor exige JWT_SECRET e DATABASE_URL de verdade.
NODE_ENV=development

# --- Parâmetros de rede ---
# Porta em que a API sobe (a doc do Swagger fica em http://localhost:PORT/docs)
PORT=2077
# Use 127.0.0.1 pra só aceitar conexão local, ou 0.0.0.0 pra aceitar de fora
HOST=127.0.0.1

# --- Banco de dados PostgreSQL ---
# Formato: postgresql://USUARIO:SENHA@HOST:PORTA/NOME_DO_BANCO?schema=public
# O `npm run dev` cria esse banco sozinho se ele ainda não existir, aplica as
# migrações e roda o seed. Você só precisa do PostgreSQL instalado e rodando.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/biometricaccesssystem?schema=public"

# --- Login do administrador ---
# É esse o e-mail e a senha que o seed garante toda vez que a API sobe.
# A senha precisa ter 8+ caracteres, com maiúscula, minúscula, número e símbolo.
SEED_ADMIN_EMAIL=admin@etec01.com.br
SEED_ADMIN_PASSWORD=Admin@123

# --- Autenticação (JWT) ---
# ATENÇÃO: gere um segredo aleatório e longo, não invente na mão.
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=troque-por-um-segredo-aleatorio-de-no-minimo-32-caracteres
# Quanto tempo o token dura antes de precisar logar de novo (ex: 8h, 30m, 7d)
JWT_EXPIRES_IN=8h

# --- CORS ---
# Endereços do frontend que podem chamar esta API, separados por vírgula.
# Em produção NUNCA deixe "*", senão qualquer site consegue falar com a API.
CORS_ORIGIN=http://localhost:5173

# --- Envio de e-mail (senha temporária e recuperação de senha) ---
# Usando Gmail: crie uma "Senha de app" em https://myaccount.google.com/apppasswords
# e coloque ela em EMAIL_PASS. Nunca use a senha real da sua conta.
EMAIL_USER=seu-email@gmail.com
EMAIL_PASS=sua-senha-de-app-de-16-digitos
EMAIL_FROM=seu-email@gmail.com

# --- Endereço público do frontend ---
# Usado nos links que vão dentro dos e-mails enviados pelo sistema
FRONTEND_URL=http://localhost:5173
